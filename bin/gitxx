#!/usr/bin/env bash
# gitxx - Command line tool to open repositories in GitXX macOS App

set -e

show_help() {
    cat << EOF
GitXX CLI - Fast repository opener for GitXX

Usage:
    gitxx [OPTIONS] [DIRECTORY | GITHUB_URL]

Arguments:
    DIRECTORY    Path to git repository (defaults to current working directory)
    GITHUB_URL   A github.com link (repo, pull request, branch, commit, Actions run)
                 opened on its page in GitXX when the repository is on this Mac

Options:
    -h, --help       Show this help message
    -v, --version    Show GitXX CLI version
    --install        Install symlink into ~/.local/bin

Examples:
    gitxx            Open repository in current directory
    gitxx .          Open repository in current directory
    gitxx ../my-repo Open repository at ../my-repo
    gitxx https://github.com/owner/repo/pull/42   Open that pull request
    gitxx --link "\$1"   For Shortcuts: the passed link, or the current browser tab
EOF
    exit 0
}

if [ "$1" = "-h" ] || [ "$1" = "--help" ]; then
    show_help
fi

if [ "$1" = "-v" ] || [ "$1" = "--version" ]; then
    echo "gitxx CLI version 1.0.0"
    exit 0
fi

if [ "$1" = "--install" ]; then
    SCRIPT_PATH="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
    TARGET_DIR="$HOME/.local/bin"
    mkdir -p "$TARGET_DIR"
    ln -sf "$SCRIPT_PATH" "$TARGET_DIR/gitxx"
    echo "✅ Successfully installed 'gitxx' to $TARGET_DIR/gitxx"
    exit 0
fi

# Address of the frontmost browser's current tab (Safari and Chromium-based browsers), or of the first running one.
current_browser_url() {
    osascript <<'APPLESCRIPT' 2>/dev/null
set chromiums to {"Google Chrome", "Arc", "Brave Browser", "Microsoft Edge", "Chromium", "Vivaldi", "Google Chrome Canary"}
set frontApp to ""
try
    tell application "System Events" to set frontApp to name of first application process whose frontmost is true
end try
set candidates to {frontApp} & {"Safari", "Safari Technology Preview"} & chromiums
repeat with appName in candidates
    set appName to appName as text
    if application appName is running then
        try
            if appName starts with "Safari" then
                return run script "tell application \"" & appName & "\" to return URL of front document"
            else if chromiums contains appName then
                return run script "tell application \"" & appName & "\" to return URL of active tab of front window"
            end if
        end try
    end if
end repeat
return ""
APPLESCRIPT
}

# A GitHub (or any web) link opens that page in GitXX instead of a directory.
# `--link [URL]` (for Shortcuts / Quick Actions): with no URL, uses the current browser tab.
URL_ARG=""
if [ "$1" = "--link" ]; then
    URL_ARG="$2"
    if [ -z "$URL_ARG" ]; then
        URL_ARG="$(current_browser_url)"
    fi
    if [[ ! "$URL_ARG" =~ ^https?:// ]]; then
        echo "❌ Error: no link was passed and no browser tab address could be read." >&2
        osascript -e 'display notification "No link was passed and no browser tab address could be read." with title "GitXX"' 2>/dev/null || true
        exit 1
    fi
elif [[ "$1" =~ ^https?:// ]]; then
    URL_ARG="$1"
fi

if [ -z "$URL_ARG" ]; then
    # 1. Resolve target directory (default to current directory)
    TARGET_DIR="${1:-.}"

    if [ ! -d "$TARGET_DIR" ]; then
        echo "❌ Error: '$TARGET_DIR' is not a valid directory." >&2
        exit 1
    fi

    TARGET_PATH=$(cd "$TARGET_DIR" 2>/dev/null && pwd -P)

    # 2. Verify if directory is a git repository
    if ! git -C "$TARGET_PATH" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        echo "❌ Error: '$TARGET_PATH' is not a git repository." >&2
        exit 1
    fi

    # 3. Resolve git repository top-level root
    REPO_ROOT=$(git -C "$TARGET_PATH" rev-parse --show-toplevel)
fi

# 4. Locate GitXX application
APP_PATH=""
if [ -d "/Applications/GitXX.app" ]; then
    APP_PATH="/Applications/GitXX.app"
elif [ -d "$HOME/Applications/GitXX.app" ]; then
    APP_PATH="$HOME/Applications/GitXX.app"
fi

# Fallback: check relative to script bundle if inside GitXX.app
SCRIPT_DIR="$(cd "$(dirname "$0")" 2>/dev/null && pwd)"
if [[ "$SCRIPT_DIR" == *"/GitXX.app/"* ]]; then
    BUNDLE_ROOT="${SCRIPT_DIR%%/GitXX.app/*}/GitXX.app"
    if [ -d "$BUNDLE_ROOT" ]; then
        APP_PATH="$BUNDLE_ROOT"
    fi
fi

# Fallback: development build next to this script's checkout (follows the ~/.local/bin symlink)
SELF="$0"
while [ -L "$SELF" ]; do SELF="$(readlink "$SELF")"; done
DEV_APP="$(cd "$(dirname "$SELF")/.." 2>/dev/null && pwd)/GitXX.app"
if [ -z "$APP_PATH" ] && [ -d "$DEV_APP" ]; then
    APP_PATH="$DEV_APP"
fi

if [ -n "$URL_ARG" ]; then
    open -a "${APP_PATH:-GitXX}" "$URL_ARG"
    echo "🚀 Opened in GitXX: $URL_ARG"
    exit 0
fi

# 5. Send open command to single active window
ENCODED_PATH=$(python3 -c 'import urllib.parse, sys; print(urllib.parse.quote(sys.argv[1]))' "$REPO_ROOT" 2>/dev/null || echo "$REPO_ROOT")

if ! pgrep -x "GitXX" >/dev/null 2>&1; then
    # App is not running: launch it with --open
    if [ -n "$APP_PATH" ]; then
        open -a "$APP_PATH" --args --open "$REPO_ROOT"
    else
        open -a "GitXX" --args --open "$REPO_ROOT"
    fi
else
    # App is already running: send URL to single active window without creating extra windows or tabs
    open "gitxx://open?path=$ENCODED_PATH" 2>/dev/null || {
        if [ -n "$APP_PATH" ]; then
            open -a "$APP_PATH"
        else
            open -a "GitXX"
        fi
    }
fi

echo "🚀 Opened in GitXX: $(basename "$REPO_ROOT") ($REPO_ROOT)"
