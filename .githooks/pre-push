#!/usr/bin/env bash
# Blocks pushes whose commits contain secrets (catches commits made with --no-verify or before the hook existed).
script="$(git rev-parse --show-toplevel)/scripts/scan-secrets.sh"
status=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
    "$script" push "$remote_sha" "$local_sha" || status=1
done
if [ "$status" -ne 0 ]; then
    echo "Push blocked: gitleaks found possible secrets (see above). Remove them from history before pushing." >&2
fi
exit "$status"
